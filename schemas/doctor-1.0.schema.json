{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "engineVersion",
    "rulesetVersion",
    "kind",
    "runtimeSupported",
    "platform",
    "architecture",
    "adapters",
    "checks",
    "overrides"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rulesetVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "doctor"
    },
    "runtimeSupported": {
      "type": "boolean"
    },
    "platform": {
      "enum": [
        "aix",
        "darwin",
        "freebsd",
        "linux",
        "openbsd",
        "sunos",
        "win32"
      ]
    },
    "architecture": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "adapters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "adapterVersion"
        ],
        "properties": {
          "kind": {
            "enum": [
              "codex",
              "claude-code",
              "cursor",
              "kiro",
              "vscode",
              "generic-mcp"
            ]
          },
          "adapterVersion": {
            "const": "1.0.0"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "message"
        ],
        "properties": {
          "id": {
            "enum": [
              "escape",
              "score"
            ]
          },
          "state": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 480,
            "pattern": "^[\\x20-\\x7e]*$"
          }
        },
        "additionalProperties": false
      }
    },
    "overrides": {
      "type": "object",
      "required": [
        "codexHome",
        "claudeConfigDir"
      ],
      "properties": {
        "codexHome": {
          "type": "boolean"
        },
        "claudeConfigDir": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
